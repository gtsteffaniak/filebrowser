# Local listing-performance runs only. CI and test-playwright use Dockerfile.playwright-base (chromium).
FROM node:22-slim
WORKDIR /app/frontend

RUN npm i @playwright/test@1.54.1 oauth2-mock-server @types/node

ARG PLAYWRIGHT_BROWSERS=chromium,firefox,webkit
RUN set -e; \
	for b in $(echo "$PLAYWRIGHT_BROWSERS" | tr ',' ' '); do \
		npx playwright install --with-deps "$$b"; \
	done
