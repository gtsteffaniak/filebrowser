FROM node:26-slim
WORKDIR /app/frontend

COPY frontend/package-lock.json /tmp/package-lock.json
RUN PW_VERSION=$(node -p "require('/tmp/package-lock.json').packages['node_modules/@playwright/test'].version") \
  && npm i "@playwright/test@${PW_VERSION}" oauth2-mock-server @types/node
ARG PLAYWRIGHT_BROWSERS="chromium-headless-shell"
RUN npx playwright install --with-deps ${PLAYWRIGHT_BROWSERS}
