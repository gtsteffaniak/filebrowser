{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../"
  },
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!dist",
			"!public/config.generated.yaml",
			"!public/index.html",
			"!node_modules",
			"!test-results"
		]
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noAutofocus": "off",
				"noNoninteractiveElementToInteractiveRole": "off",
				"noStaticElementInteractions": "off",
				"noSvgWithoutTitle": "off",
				"useAriaPropsSupportedByRole": "off",
				"useGenericFontNames": "off",
				"useKeyWithClickEvents": "off",
				"useMediaCaption": "off",
				"useSemanticElements": "off",
				"useValidAnchor": "off"
			},
			"complexity": {
				"noForEach": "on",
				"noImportantStyles": "off",
				"noRedundantDefaultExport": "warn",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessStringConcat": "warn",
        "useMathMinMax": "warn"
			},
			"correctness": {
				"noUnknownPseudoClass": "off",
				"noVueImportCompilerMacros": "error",
				"noVueRefAsOperand": "error",
				"noVueVOnNumberValues": "error",
				"useVueValidVFor": "error",
        "noVueVIfWithVFor": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noImpliedEval": "error",
				"noJsonUnsafeValues": "error",
				"noMisusedPromises": "error",
				"noVueDeprecatedScopedSlots": "error",
				"noVueUndeclaredDirectives": "off",
				"useConsistentObjectKeys": "error",
				"useVueBaseImport": "warn",
        "noDoubleComparison": "on",
        "noNestedSwitch": "on",
        "noVueLifecycleAfterAwait": "error",
        "noVueShadowNativeEvents": "warn",
        "noVueVHtml": "error",
        "noVueVText": "warn",
        "noVueVTextVHtmlOnComponent": "error",
        "useSimplifiedBooleanReturn": "warn",
        "useVueConsistentEventHyphenation": "warn",
        "noPromiseExecutorReturn": "warn",
        "noArgumentsCallerOrCallee": "warn",
        "noVueRequiredPropWithDefault": "warn",
        "noBooleanSortComparator": "error",
        "noObsoleteAttributes": "error",
        "noPlaywrightNthMethods": "warn",
        "noUnsafeReturn": "warn",
        "noUselessSplice": "warn",
        "noVueWatchAfterAwait": "error",
        "useMathAbs": "warn",
        "useMathTrunc": "warn",
        "useVueComponentIs": "error",
        "useVueTypedRef": "error",
        "noReturnArrayPush": "warn",
        "noUselessRecursion": "error",
        "noVueComputedPropertiesInData": "error",
        "noVueDeprecatedDeleteSet": "error",
        "noVueDeprecatedRouterLinkTagProp": "error",
        "noVueMutatingProps": "error",
        "noVueMultipleSlotArgs": "warn",
        "noVueSideEffectsInComputed": "error",
        "noVueUnusedRefs": "error",
        "useVueTemplateRef": "warn",
        "useVueTypedProps": "warn",
        "useVueVModel": "warn",
        "useVueValidDefineEmits": "error",
        "useVueValidDefineProps": "error",
        "useVueValidVIs": "error",
        "useVueValidVModel": "error",
        "useVueValidVShow": "error",
        "useVueValidVSlot": "error",
        "noVueDeprecatedListeners": "error",
        "noArrayForEach": "error",
        "noChainedComparison": "error",
        "noDynamicDelete": "warn",
        "noLateEventControl": "error",
        "noObjectLiteralComparison": "error",
        "noPlaywrightUnsafeReferences": "error",
        "noUnnecessaryStringTrim": "warn",
        "noUselessLengthCheck": "info",
        "noUselessTypeAssertion": "warn",
        "noVueChildContent": "error",
        "noVueDeprecatedConfigKeyCodes": "info",
        "noVueDeprecatedEventsApi": "error",
        "noVueDeprecatedHtmlElementIs": "error",
        "noVueDeprecatedModelDefinition": "error",
        "noVueDeprecatedPropsDefaultThis": "error",
        "noVueDeprecatedVBindSync": "error",
        "noVueLoneTemplate": "error",
        "noVueMixin": "error",
        "noVueMultipleObjectsInClass": "warn",
        "noVueRefObjectReactivityLoss": "error",
        "noVueRestrictedCallAfterAwait": "error",
        "noVueRestrictedVOn": "warn",
        "noVueTemplateKey": "error",
        "noVueTemplateShadow": "warn",
        "noVueThisInTemplate": "warn",
        "noVueUndeclaredEmits": "warn",
        "noVueUndeclaredProperties": "error",
        "noVueUndeclaredSlots": "warn",
        "noVueUselessVBind": "warn",
        "noVueUselessTemplateAttributes": "error",
        "noVueVForTemplateKeyOnChild": "error",
        "useObjectFromEntries": "warn",
        "useVueBlockOrder": {
          "level": "on",
          "options": {
            "order": [
              "template",
              "script",
              "style"
            ]
          }
        },
      "useVueBooleanPropTypeFirst": "warn",
      "useVueComputedPropertyReturn": "error",
      "useVueEmitValidator": "warn",
      "useVueEmitsValidatorReturn": "error",
      "useVuePropTypeConstructor": "error",
      "useVueRenderReturn": "error",
      "useVueSingleEventPayload": "warn",
      "useVueTypedObjectProps": "warn",
      "useVueValidDefaultProp": "error",
      "useVueValidNextTick": "error",
      "useVueValidDefineOptions": "error",
      "noRedundantTypeConstituents": "warn",
      "noUselessSpread": "warn",
      "noVueExposeAfterAwait": "error"
			},
			"performance": { "useVueVapor": "off" },
			"security": {
        "preset": "recommended",
        "useIframeSandbox": "off"
      },
			"style": {
				"noDescendingSpecificity": "off",
				"noTopLevelLiterals": "error",
				"noVueOptionsApi": "off",
				"useVueConsistentDefinePropsDeclaration": "on",
				"useVueConsistentVBindStyle": "off",
				"useVueHyphenatedAttributes": "off",
				"useVueMultiWordComponentNames": "off",
				"useVueNextTickPromise": "warn",
        "useImportsFirst": "off",
        "useVarsOnTop": "on",
        "useDomQuerySelector": "warn",
        "useVueDefineMacrosOrder": "warn"
			},
			"suspicious": {
				"noEmptyObjectKeys": "error",
				"noExplicitAny": "warn",
				"noImportCycles": "off",
				"noNestedPromises": "error",
				"noParametersOnlyUsedInRecursion": "error",
				"noShadow": "off",
				"noUnnecessaryConditions": "off",
				"useArraySortCompare": "error",
				"useScopedStyles": "off",
        "noConfusingVoidType": "warn"
			}
		},
		"domains": { "vue": "all", "project": "all", "types": "all" }
	},
	"css": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false },
		"assist": { "enabled": false }
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"parser": { "interpolation": true },
		"linter": { "enabled": true }
	},
	"overrides": [
		{
			"includes": ["tests/playwright/**"],
			"linter": {
				"rules": {
					"complexity": { "noPlaywrightUselessAwait": "error" },
					"correctness": {
						"noEmptyPattern": "off",
						"noPlaywrightMissingAwait": "error",
						"noUnresolvedImports": "off",
						"usePlaywrightValidDescribeCallback": "error"
					},
					"style": {
						"noPlaywrightElementHandle": "error",
						"noPlaywrightEval": "error",
						"noPlaywrightWaitForSelector": "error"
					},
					"suspicious": {
						"noPlaywrightForceOption": "error",
						"noPlaywrightNetworkidle": "error",
						"noPlaywrightPagePause": "error",
						"noPlaywrightWaitForNavigation": "error",
						"noPlaywrightWaitForTimeout": "warn",
            "noEmptyObjectKeys": "error"
					}
				}
			}
		},
		{
			"includes": [
				"scripts/postcss-strip-legacy.ts",
				"playwright.config.ts",
				"playwright.performance.config.ts",
				"**/*.test.js",
				"**/*.test.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredDependencies": "off",
						"noUnresolvedImports": "off"
					}
				}
			}
		}
	],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off",
        "useGraphqlSortedDefinitions": "on"
      }
    }
  }
}
