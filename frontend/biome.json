{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!dist",
			"!public/config.generated.yaml",
			"!public/index.html",
			"!node_modules",
			"!test-results"
		]
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noAutofocus": "off",
				"noNoninteractiveElementToInteractiveRole": "off",
				"noStaticElementInteractions": "off",
				"noSvgWithoutTitle": "off",
				"useAriaPropsSupportedByRole": "off",
				"useGenericFontNames": "off",
				"useKeyWithClickEvents": "off",
				"useMediaCaption": "off",
				"useSemanticElements": "off",
				"useValidAnchor": "off"
			},
			"complexity": {
				"noForEach": "on",
				"noImportantStyles": "off",
				"noRedundantDefaultExport": "warn"
			},
			"correctness": {
				"noUnknownPseudoClass": "off",
				"noVueImportCompilerMacros": "error",
				"noVueRefAsOperand": "error",
				"noVueVOnNumberValues": "error",
				"useVueValidVFor": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noImpliedEval": "error",
				"noJsonUnsafeValues": "error",
				"noMisusedPromises": "error",
				"noVueDeprecatedScopedSlots": "error",
				"noVueUndeclaredDirectives": "off",
				"useConsistentObjectKeys": "error",
				"useVueBaseImport": "warn"
			},
			"performance": { "useVueVapor": "off" },
			"security": { "preset": "recommended" },
			"style": {
				"noDescendingSpecificity": "off",
				"noTopLevelLiterals": "error",
				"noVueOptionsApi": "off",
				"useVueConsistentDefinePropsDeclaration": "off",
				"useVueConsistentVBindStyle": "off",
				"useVueHyphenatedAttributes": "off",
				"useVueMultiWordComponentNames": "off",
				"useVueNextTickPromise": "warn"
			},
			"suspicious": {
				"noEmptyObjectKeys": "error",
				"noExplicitAny": "warn",
				"noImportCycles": "off",
				"noNestedPromises": "error",
				"noParametersOnlyUsedInRecursion": "error",
				"noShadow": "off",
				"noUnnecessaryConditions": "off",
				"useArraySortCompare": "error",
				"useScopedStyles": "off"
			}
		},
		"domains": { "vue": "all", "project": "all", "types": "all" }
	},
	"css": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false },
		"assist": { "enabled": false }
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"parser": { "interpolation": true },
		"linter": { "enabled": true }
	},
	"overrides": [
		{
			"includes": ["tests/playwright/**"],
			"linter": {
				"rules": {
					"complexity": { "noPlaywrightUselessAwait": "error" },
					"correctness": {
						"noEmptyPattern": "off",
						"noPlaywrightMissingAwait": "error",
						"noUnresolvedImports": "off",
						"usePlaywrightValidDescribeCallback": "error"
					},
					"style": {
						"noPlaywrightElementHandle": "error",
						"noPlaywrightEval": "error",
						"noPlaywrightWaitForSelector": "error"
					},
					"suspicious": {
						"noPlaywrightForceOption": "error",
						"noPlaywrightNetworkidle": "error",
						"noPlaywrightPagePause": "error",
						"noPlaywrightWaitForNavigation": "error",
						"noPlaywrightWaitForTimeout": "warn"
					}
				}
			}
		},
		{
			"includes": [
				"scripts/postcss-strip-legacy.ts",
				"playwright.config.ts",
				"playwright.performance.config.ts",
				"**/*.test.js",
				"**/*.test.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredDependencies": "off",
						"noUnresolvedImports": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "off" } }
	}
}
