{
  "name": "filebrowser-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=9.0.0",
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "mkdir -p ../backend/internal/web/embed && rm -rf ../backend/internal/web/embed/* && vite build && cp -r ../backend/internal/web/dist/* ../backend/internal/web/embed",
    "build:docker": "vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc --build",
    "lint": "biome check && eslint src/",
    "lint:fix": "biome check --write && eslint --fix src/",
    "lint:biome": "biome check",
    "lint:biome:fix": "biome check --write",
    "lint:eslint": "eslint src/",
    "format": "biome format --write",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "lint:css:fix": "stylelint --fix \"**/*.{css,vue}\"",
    "i18n:sync": "node ./scripts/sync-translations.js",
    "i18n:check": "node ./scripts/sync-translations.js --check",
    "i18n:enforce-order": "node scripts/sync-translations.js --enforce-order",
    "i18n:cleanup": "node scripts/sync-translations.js --cleanup",
    "icons:sync": "node ./scripts/build-icon-subset.js",
    "icons:check": "node ./scripts/build-icon-subset.js --check",
    "test": "vitest run "
  },
  "dependencies": {
    "@likecoin/epub-ts": "^0.7.2",
    "@onlyoffice/document-editor-vue": "^1.7.0",
    "ace-builds": "^1.45.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "plyr": "^3.8.5",
    "qrcode.vue": "^3.11.0",
    "temml": "^0.14.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "@xmldom/xmldom": "^0.8.15",
    "mammoth": {
      "argparse": "^2.0.1"
    },
    "@intlify/vue-i18n-extensions": {
      "vue-i18n": "$vue-i18n"
    },
    "@intlify/eslint-plugin-vue-i18n": {
      "glob": "^13.0.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "deepl-node": "^1.28.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "wawoff2": "^2.0.1"
  }
}
