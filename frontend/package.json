{
  "name": "filebrowser-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=11.20.0",
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build",
    "build:docker": "SKIP_TYPECHECK=1 vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc --build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "i18n:check": "node scripts/i18n/index.ts check",
    "i18n:check:strict": "node scripts/i18n/index.ts check --strict",
    "i18n:types": "node scripts/i18n/index.ts types",
    "i18n:sync": "node scripts/i18n/index.ts sync",
    "i18n:cleanup": "node scripts/i18n/index.ts sync --cleanup",
    "i18n:reorder": "node scripts/i18n/index.ts sync --reorder",
    "icons:sync": "node ./scripts/build-icon-subset.js",
    "icons:check": "node ./scripts/build-icon-subset.js --check",
    "test": "vitest run "
  },
  "dependencies": {
    "@likecoin/epub-ts": "^0.7.4",
    "@onlyoffice/document-editor-vue": "^1.7.0",
    "ace-builds": "^1.45.2",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "hls.js": "^1.7.4",
    "js-yaml": "^5.5.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "plyr": "^3.8.5",
    "qrcode.vue": "^3.11.1",
    "temml": "^0.14.0",
    "three": "^0.187.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "@xmldom/xmldom": "^0.8.15",
    "mammoth": {
      "argparse": "^3.0.4"
    },
    "@intlify/vue-i18n-extensions": {
      "vue-i18n": "$vue-i18n"
    },
    "glob": "^14.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "deepl-node": "^1.29.0",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.4.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0",
    "vite-plugin-compression2": "^2.5.4",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wawoff2": "^2.0.1"
  }
}
