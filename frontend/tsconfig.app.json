{
  "compilerOptions": {
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "types": [
      "vite/client",
      "vitest/globals",
      "@intlify/unplugin-vue-i18n/messages"
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "stableTypeOrdering": true, // this is always on in 7 from what I've read (remove this line when upgrading to 7)
    "allowJs": true, // we should remove this once there is no .js left
    "checkJs": false, // lots of errors (~1037) when enabled for now on off.
    "strict": false, // the defaults it true, for now off cuz lots of errors too.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Required in Vue projects (per official @vue/tsconfig)
    "jsx": "preserve",
    "jsxImportSource": "vue",

    // See <https://github.com/vuejs/vue-cli/pull/5688>
    "skipLibCheck": true,

    // Any imports or exports without a type modifier are left around. This is important for `<script setup>`.
    // Anything that uses the type modifier is dropped entirely.
    //"verbatimModuleSyntax": true,

    // optional
    // "noImplicitOverride": true,
    // "noUncheckedIndexedAccess": true, // only after strict

    // we enable this below one by one, later we can remove them when strict is true
    "noImplicitThis": true,
    // "noImplicitAny": true,
    // "strictNullChecks": true,
    // "strictFunctionTypes": true,
    // "strictBindCallApply": true,
    // "strictPropertyInitialization": true,
    // "alwaysStrict": true,
    // "useUnknownInCatchVariables": true,
    // "strictBuiltinIteratorReturn": true,
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ]
}
