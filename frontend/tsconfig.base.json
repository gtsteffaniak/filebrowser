{
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "stableTypeOrdering": true, // this is always on in 7 from what I read
    "allowJs": true, // we should remove this once there is no .js left
    "checkJs": false, // lots of errors (~1037) when enabled for now on off.
    "strict": false, // the defaults it true, for now off cuz lots of errors too.
    "noImplicitThis": true, // remove once we enable strict (strict already includes it)
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // --- we enable this below one by one, later we can remove them when strict is true ---
    // "noImplicitAny": true,
    // "strictNullChecks": true,
    // "strictFunctionTypes": true,
    // "strictBindCallApply": true,
    // "strictPropertyInitialization": true,
    // "alwaysStrict": true,
    // "useUnknownInCatchVariables": true,
    // "strictBuiltinIteratorReturn": true,

    // --- optional ---
    // "verbatimModuleSyntax": true, // forces import type
    // "noImplicitOverride": true,
    // "noUncheckedIndexedAccess": true, // only after strict
  }
}
